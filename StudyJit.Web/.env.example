# Copy to .env for docker compose, or to .env.local for npm run dev. On the server the Publish Web workflow writes it.

# Host-side port the reverse proxy forwards to
WEB_PORT=22344

# The API this site signs in to and calls. The API must allow this site's address (Cors__AllowedOrigins, from the
# WEB_URL variable).
NEXT_PUBLIC_API_URL=http://localhost:5080
