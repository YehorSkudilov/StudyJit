# Copy to .env (git-ignored). CI passes these as variables instead.

# The StudyJit API the app talks to, in Debug and Release builds alike, e.g. https://api.example.com/
# For the local API (StudyJit.Api's https profile): https://localhost:<port>/ - or https://10.0.2.2:<port>/
# from the Android emulator. Debug builds accept the local development certificate for those two hosts.
API_BASE_URL=

# The website (StudyJit.Web), e.g. https://studyjit.example.com/ - for the privacy policy, terms and the links to
# the full course tools on the web. Optional: leave empty to hide those links.
WEB_BASE_URL=
