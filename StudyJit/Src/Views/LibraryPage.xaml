<?xml version="1.0" encoding="utf-8" ?>
<views:TabView
    x:Class="StudyJit.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:StudyJit.Views"
    xmlns:vm="clr-namespace:StudyJit.ViewModels"
    x:DataType="vm:LibraryViewModel">

    <VerticalStackLayout Spacing="14">
        <Label Text="Library" Style="{StaticResource Title}" />

        <Border Style="{StaticResource InputBox}" HeightRequest="44" Padding="10,0">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                <Image Source="{StaticResource IconSearch}" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                <Entry Grid.Column="1" Text="{Binding Search}" Placeholder="Search study sets and courses" ClearButtonVisibility="WhileEditing" />
            </Grid>
        </Border>

        <!-- All / Study sets / Exams -->
        <HorizontalStackLayout Spacing="8">
            <Button Text="All" Command="{Binding SetFilterCommand}" CommandParameter="0" Style="{StaticResource SmallButton}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsAll}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Text="Study sets" Command="{Binding SetFilterCommand}" CommandParameter="1" Style="{StaticResource SmallButton}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsSets}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Text="Exams" Command="{Binding SetFilterCommand}" CommandParameter="2" Style="{StaticResource SmallButton}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsExams}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </HorizontalStackLayout>

        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Margin="0,40" />
        <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" Margin="0,40" />
        <Label Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" Margin="20,40" />

        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="10">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="vm:QuizItem">
                    <views:QuizRow />
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
    </VerticalStackLayout>
</views:TabView>
