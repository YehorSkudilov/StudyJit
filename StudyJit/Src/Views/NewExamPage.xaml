<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="StudyJit.Views.NewExamPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:StudyJit.Views"
    xmlns:vm="clr-namespace:StudyJit.ViewModels"
    x:DataType="vm:NewExamViewModel"
    Title="New exam">

    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="10,8,10,24" Spacing="14">
                <Label Text="NAME" Style="{StaticResource Overline}" />
                <Border Style="{StaticResource InputBox}" HeightRequest="48" Padding="10,0">
                    <Entry Text="{Binding Name}" Placeholder="E.g. Midterm 1" />
                </Border>

                <Label Text="WHAT IT COVERS" Style="{StaticResource Overline}" />
                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" />
                <Border Style="{StaticResource Card}" Padding="4">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sets}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:PickItem">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Padding="6,2">
                                    <CheckBox IsChecked="{Binding IsPicked}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Name}" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <Label Text="ANYTHING TO FOCUS ON" Style="{StaticResource Overline}" />
                <Border Style="{StaticResource InputBox}" HeightRequest="110" Padding="8,4">
                    <Editor Text="{Binding Focus}" Placeholder="Optional, e.g. more on chapter 4, include calculations" AutoSize="Disabled" />
                </Border>
                <Label Text="The AI writes the exam from the picked study sets' files and guides. It takes a few minutes." Style="{StaticResource Caption}" />
            </VerticalStackLayout>
        </ScrollView>
        <Button Grid.Row="1" Text="Create exam" Style="{StaticResource PrimaryButton}" Margin="10,8,10,16"
                Command="{Binding CreateCommand}" IsEnabled="{Binding IsSaving, Converter={StaticResource Not}}" />
    </Grid>
</views:BasePage>
