<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="StudyJit.Views.CoursePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:StudyJit.Views"
    xmlns:vm="clr-namespace:StudyJit.ViewModels"
    x:DataType="vm:CourseViewModel"
    Title="{Binding Code}">

    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="{StaticResource IconMore}" Text="More" Command="{Binding MenuCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="10,8,10,24" Spacing="14">
                <!-- The course's banner -->
                <Border StrokeShape="RoundRectangle 22" Background="{Binding Gradient}" Padding="18">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="24" TextColor="White" />
                        <Label Text="{Binding Summary}" FontSize="13" TextColor="#E6FFFFFF" />
                    </VerticalStackLayout>
                </Border>

                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Margin="0,30" />
                <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />

                <!-- Study sets / Exams / Files -->
                <Border Style="{StaticResource Pill}" Padding="4">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                        <Button Text="Study sets" Command="{Binding ShowSectionCommand}" CommandParameter="0" Style="{StaticResource SegmentButton}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsSetsTab}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="1" Text="Exams" Command="{Binding ShowSectionCommand}" CommandParameter="1" Style="{StaticResource SegmentButton}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsExamsTab}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="2" Text="Files" Command="{Binding ShowSectionCommand}" CommandParameter="2" Style="{StaticResource SegmentButton}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsFilesTab}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                </Border>

                <!-- Study sets: one per folder of files, made and kept up to date on their own -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding IsSetsTab}">
                    <Border Style="{StaticResource Card}" IsVisible="{Binding NoSets}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="No study sets yet" Style="{StaticResource H3}" />
                            <Label Text="Upload your course files on the Files tab. Each folder of files becomes a study set, written by the AI."
                                   Style="{StaticResource Caption}" />
                            <Button Text="Upload files" Command="{Binding UploadFilesCommand}" />
                        </VerticalStackLayout>
                    </Border>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sets}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:QuizItem">
                                <views:QuizRow />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Exams: built from chosen study sets -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding IsExamsTab}">
                    <Button Text="New exam" Command="{Binding NewExamCommand}" />
                    <Label Text="An exam mixes questions from the study sets you pick, e.g. the ones a midterm covers."
                           Style="{StaticResource Caption}" IsVisible="{Binding NoExams}" HorizontalTextAlignment="Center" Margin="10,6" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Exams}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:QuizItem">
                                <views:QuizRow />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Files, by folder -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsFilesTab}">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="10">
                        <Button Text="Upload files" Command="{Binding UploadFilesCommand}" />
                        <Button Grid.Column="1" Text="YouTube video" Command="{Binding AddVideoCommand}" Style="{StaticResource SecondaryButton}" />
                        <Button Grid.Row="1" Text="New folder" Command="{Binding NewFolderCommand}" Style="{StaticResource SecondaryButton}" />
                        <Button Grid.Row="1" Grid.Column="1" Text="Sort with AI" Command="{Binding OrganizeCommand}" Style="{StaticResource SecondaryButton}" />
                    </Grid>

                    <Border Style="{StaticResource Card}" IsVisible="{Binding IsUploading}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Upload}" FontFamily="OpenSansSemibold" LineBreakMode="TailTruncation" />
                            <ProgressBar Progress="{Binding UploadProgress}" />
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="PDFs, slides, documents, pictures, audio and video all work. Folders (e.g. one per week) each get their own study set."
                           Style="{StaticResource Caption}" IsVisible="{Binding NoFiles}" HorizontalTextAlignment="Center" Margin="10,6" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Folders}" Spacing="14">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:FolderGroup">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Padding="4,0">
                                        <Image Source="{StaticResource IconFolder}" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding Name}" FontFamily="OpenSansSemibold" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                        <HorizontalStackLayout Grid.Column="2" Spacing="4">
                                            <Label Text="{Binding Count}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                                            <ImageButton Source="{StaticResource IconMore}" WidthRequest="32" HeightRequest="32" Padding="6"
                                                         IsVisible="{Binding HasMenu}" Command="{Binding MenuCommand}" BackgroundColor="Transparent" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                    <Border Style="{StaticResource Card}" Padding="0">
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Files}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="vm:FileItem">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,10">
                                                        <Grid.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding MenuCommand}" />
                                                        </Grid.GestureRecognizers>
                                                        <Label Text="{Binding Glyph}" FontFamily="OutlinedIcons" FontSize="22" TextColor="{StaticResource Accent}" VerticalOptions="Center" />
                                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                            <Label Text="{Binding Name}" FontSize="14" LineBreakMode="MiddleTruncation" />
                                                            <Label Text="{Binding Details}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                                                        </VerticalStackLayout>
                                                        <Image Grid.Column="2" Source="{StaticResource IconMore}" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </Border>
                                    <Label Text="Empty folder" Style="{StaticResource Caption}" IsVisible="{Binding IsEmpty}" Margin="6,0" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Something's under way (an AI request, a save) -->
        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsWorking}" IsVisible="{Binding IsWorking}" Margin="0,8" />
    </Grid>
</views:BasePage>
