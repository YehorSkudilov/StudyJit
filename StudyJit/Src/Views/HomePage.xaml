<?xml version="1.0" encoding="utf-8" ?>
<views:TabView
    x:Class="StudyJit.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:StudyJit.Views"
    xmlns:vm="clr-namespace:StudyJit.ViewModels"
    x:DataType="vm:HomeViewModel">

    <VerticalStackLayout Spacing="16">
        <Label Text="{Binding Greeting}" Style="{StaticResource Title}" />

        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Margin="0,40" />
        <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" Margin="0,40" />

        <!-- How studying is going -->
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" IsVisible="{Binding HasCourses}">
            <Border Style="{StaticResource Card}" Padding="14">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding CourseCount}" Style="{StaticResource StatValue}" />
                    <Label Text="Courses" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding ReadyCount}" Style="{StaticResource StatValue}" />
                    <Label Text="Sets ready" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding AverageScore}" Style="{StaticResource StatValue}" />
                    <Label Text="Average" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- No courses yet: what StudyJit does, and the way in -->
        <Border Style="{StaticResource Card}" Padding="20" IsVisible="{Binding IsEmpty}">
            <VerticalStackLayout Spacing="12">
                <Image Source="logo.png" HeightRequest="96" HorizontalOptions="Center" />
                <Label Text="Study smarter, just in time" Style="{StaticResource H2}" HorizontalTextAlignment="Center" />
                <Label Text="Add your courses and upload your slides, notes or lecture videos. StudyJit writes flashcards, practice questions, tests, a study guide and a cheat sheet for every folder."
                       Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                <Button Text="Add your first course" Style="{StaticResource PrimaryButton}" Command="{Binding AddCourseCommand}" />
            </VerticalStackLayout>
        </Border>

        <!-- Generating now -->
        <Label Text="GENERATING NOW" Style="{StaticResource Overline}" IsVisible="{Binding HasGenerating}" />
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Generating}" Spacing="10" IsVisible="{Binding HasGenerating}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="vm:QuizItem">
                    <views:QuizRow />
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

        <!-- What to study next -->
        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasRecent}">
            <Label Text="STUDY NEXT" Style="{StaticResource Overline}" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="All courses" Style="{StaticResource GhostButton}" Command="{Binding OpenCoursesCommand}" />
        </Grid>
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Recent}" Spacing="10" IsVisible="{Binding HasRecent}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="vm:QuizItem">
                    <views:QuizRow />
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
    </VerticalStackLayout>
</views:TabView>
