<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="StudyJit.Views.SetPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:StudyJit.Views"
    xmlns:vm="clr-namespace:StudyJit.ViewModels"
    x:DataType="vm:SetViewModel"
    Title="{Binding Name}">

    <ScrollView>
        <VerticalStackLayout Padding="10,8,10,24" Spacing="14">
            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Margin="0,40" />
            <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" Margin="0,40" />

            <!-- What it is -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding Kind}" Style="{StaticResource Overline}" />
                    <Label Text="{Binding Name}" Style="{StaticResource H2}" />
                    <Label Text="{Binding Description}" Style="{StaticResource Caption}" />
                    <Label Text="{Binding Contents}" Style="{StaticResource Caption}" TextColor="{StaticResource TextTertiary}" />
                </VerticalStackLayout>
                <!-- The last score, in a ring -->
                <Border Grid.Column="1" IsVisible="{Binding HasScore}" WidthRequest="72" HeightRequest="72" StrokeShape="RoundRectangle 36"
                        StrokeThickness="4" Stroke="{StaticResource Accent}" VerticalOptions="Start">
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="{Binding Score}" FontFamily="OpenSansSemibold" FontSize="18" HorizontalOptions="Center" />
                        <Label Text="last" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Not ready: being written (with its progress), waiting, or failed -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding IsNotReady}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Image Source="{StaticResource IconSparkle}" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding StatusTitle}" Style="{StaticResource H3}" VerticalOptions="Center" />
                    </Grid>
                    <Label Text="{Binding StatusText}" Style="{StaticResource Caption}" />
                    <ProgressBar Progress="{Binding Progress}" IsVisible="{Binding IsRunning}" ProgressColor="{StaticResource Accent2}" />
                </VerticalStackLayout>
            </Border>

            <!-- The ways to study it -->
            <Label Text="STUDY" Style="{StaticResource Overline}" IsVisible="{Binding IsReady}" Margin="4,4,0,0" />
            <FlexLayout BindableLayout.ItemsSource="{Binding Modes}" Wrap="Wrap" JustifyContent="SpaceBetween" IsVisible="{Binding IsReady}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModeItem">
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10" FlexLayout.Basis="48.5%" Opacity="{Binding TileOpacity}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCommand}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="8">
                                <Border WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 12" Background="{Binding Gradient}" HorizontalOptions="Start">
                                    <Label Text="{Binding Glyph}" FontFamily="OutlinedIcons" FontSize="22" TextColor="White"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" />
                                <Label Text="{Binding Blurb}" FontSize="12" TextColor="{StaticResource TextSecondary}" MaxLines="3" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,6,0,0">
                <Button Text="Regenerate" Style="{StaticResource SecondaryButton}" Command="{Binding RegenerateCommand}" />
                <Button Grid.Column="1" Text="Delete" Style="{StaticResource SecondaryButton}" TextColor="{StaticResource Danger}" Command="{Binding DeleteCommand}" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>
