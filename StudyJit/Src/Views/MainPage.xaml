<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StudyJit.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:skeleton="clr-namespace:AppSkeleton;assembly=AppSkeleton"
    Shell.NavBarIsVisible="False">

    <!--  The tabs as in Gym Book: a swipeable CView with AppSkeleton's glass CNavBar under it. The glass look
          (GlassTint, GlassTintOpacity) is app-wide, in Resources/Styles/Colors.xaml.  -->

    <!--  The last two rows are the nav bar's (less its margins): 34 + 34 makes it 54 tall.  -->
    <Grid RowDefinitions="*,34,34">
        <!--  Each tab scrolls and pads itself (see TabView), so tabs keep their own scroll positions. Pulling a tab down
              refreshes it, as in Gym Book: through this RefreshView on iOS, Mac and Windows; on Android CView itself
              tells the pull (its SwipeRefreshLayout is turned off, see MainPage.xaml.cs). Either way RefreshIndicator shows it.  -->
        <RefreshView
            x:Name="PageRefreshView"
            Grid.RowSpan="2"
            RefreshColor="{StaticResource Accent}"
            Refreshing="OnPageRefreshing">
            <skeleton:CView
                x:Name="TabContent"
                SwipeNavigationCommand="{Binding Source={x:Reference NavBar}, Path=SelectPageCommand}" />
        </RefreshView>

        <!--  The pull-to-refresh arrow: follows the finger down, turns over once it's far enough, spins while refreshing.  -->
        <skeleton:AcrylicView
            x:Name="RefreshIndicator"
            Margin="0,14,0,0"
            BorderColor="#40FFFFFF"
            CornerRadius="22"
            EffectStyle="Custom"
            HeightRequest="44"
            HorizontalOptions="Center"
            InputTransparent="True"
            IsVisible="False"
            Opacity="0"
            TintColor="{StaticResource GlassTint}"
            TintOpacity="{StaticResource GlassTintOpacity}"
            TranslationY="-80"
            VerticalOptions="Start"
            WidthRequest="44">
            <Label
                x:Name="RefreshArrow"
                FontFamily="OutlinedIcons"
                FontSize="20"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Text="refresh"
                TextColor="{StaticResource TextPrimary}"
                VerticalOptions="Center"
                VerticalTextAlignment="Center" />
        </skeleton:AcrylicView>
        <skeleton:CNavBar
            x:Name="NavBar"
            Grid.Row="1"
            Grid.RowSpan="2"
            Margin="10,4,10,10"
            BorderColor="Transparent"
            FontFamily="OutlinedIcons"
            IsNavigating="{Binding Source={x:Reference TabContent}, Path=IsNavigating}"
            LabelColor="{StaticResource TextSecondary}"
            SelectedFontFamily="RegularIcons"
            TintColor="{StaticResource GlassTint}"
            TintOpacity="{StaticResource GlassTintOpacity}" />
    </Grid>
</ContentPage>
