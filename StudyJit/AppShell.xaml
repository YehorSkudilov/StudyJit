<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="StudyJit.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:StudyJit.Views"
    Title="StudyJit"
    Shell.FlyoutBehavior="Disabled">

    <!-- The tabs are a CNavBar + CView inside MainPage; Shell only handles pushing detail pages on top. -->
    <ShellContent Route="main" ContentTemplate="{DataTemplate views:MainPage}" />

</Shell>
