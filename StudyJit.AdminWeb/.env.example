# Copy to .env for docker compose, or to .env.local for npm run dev. On the server the Publish Admin Web workflow writes it.

# Host-side port the reverse proxy forwards to
ADMIN_WEB_PORT=22345

# The API this admin signs in to and calls. The API must allow this site's address (Cors__AllowedOrigins, from the
# ADMIN_WEB_URL variable).
NEXT_PUBLIC_API_URL=http://localhost:5080
