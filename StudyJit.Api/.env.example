# All settings of the StudyJit API. Copy to .env (git-ignored) next to this file: docker-compose.yml passes it to the
# container, and the API loads it itself when run with dotnet run / the IDE. On the server the Publish API workflow
# writes .env from the repository's GitHub variables and secrets. "__" separates sections (Jwt__Issuer = Jwt:Issuer).

# Logging
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
Logging__LogLevel__Microsoft.EntityFrameworkCore=Warning

# Database. docker-compose.yml creates it from the POSTGRES_* values and points the container at it; the
# connection string below is for an API run outside Docker (docker compose up -d db, then dotnet run).
POSTGRES_USER=studyjit
POSTGRES_PASSWORD=studyjit_dev
POSTGRES_DB=studyjit
ConnectionStrings__Default=Host=localhost;Port=5432;Database=studyjit;Username=studyjit;Password=studyjit_dev
# Apply pending migrations at startup (always on in Development)
Database__MigrateOnStartup=false

# JWT. The signing key must be at least 32 characters.
Jwt__Issuer=studyjit-api
Jwt__Audience=studyjit-web
Jwt__SigningKey=
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30

# Swagger UI basic auth (/swagger)
SwaggerAuth__Username=admin
SwaggerAuth__Password=

# OpenAI for quiz generation; an empty key turns it off. Clear ReasoningEffort for models that aren't reasoning
# models (e.g. gpt-4o).
OpenAI__ApiKey=
OpenAI__Model=gpt-6.1-sol
OpenAI__ReasoningEffort=low
OpenAI__TimeoutSeconds=900

# Where uploaded files are kept (docker-compose.yml sets /shared-files, a volume)
Storage__Root=storage

# Admin site (StudyJit.AdminWeb): accounts made SuperAdmin at startup, comma-separated. Register on the website first;
# a SuperAdmin hands out the other roles from the admin site.
Admin__BootstrapEmails=

# The website and admin site addresses, the only sites allowed to call the API from a browser (comma-separated)
Cors__AllowedOrigins=http://localhost:3000,http://localhost:3001

# Rate limits
RateLimiting__AuthPerMinute=10

# Comma-separated CIDRs of reverse proxies whose X-Forwarded-* headers are trusted (besides loopback)
ReverseProxy__KnownNetworks=

# Host ports (consumed by docker-compose.yml): the API container, and the loopback-only database
API_PORT=8080
DB_PORT=5432
